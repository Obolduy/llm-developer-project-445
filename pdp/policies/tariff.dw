// Политики write-пути агента мобильного оператора (Dogwood: Cedar + temporal).
//
// Цикл карточки: Prepare → ConfirmCard той же карточки → Execute.
// Каждый permit требует guard_ok: без пройденной проверки текста guardrail
// действие не готовится и не подтверждается (fail-closed).
// Deny by default: оператору permit не подходит, отдельный forbid не нужен.
// Forbid перекрывает permit — так держится лимит смен тарифа.

// Подготовка: клиент с tariffs:write, идентичность в аргументах не передаётся.
@id("prepare_client_with_write")
permit (principal, action == Tel::Action::"Prepare", resource)
when {
    context.input.role == "client"
    && context.input.scopes.contains("tariffs:write")
    && context.input.guard_ok
    && !(context.input has "user_id")
    && !(context.input has "account")
    && !(context.input has "subscriber")
    && !(context.input has "msisdn")
};

// «Да» принимается только по карточке, которую недавно подготовили.
@id("confirm_prepared_card")
permit (principal, action == Tel::Action::"ConfirmCard", resource)
when {
    context.input.role == "client"
    && context.input.scopes.contains("tariffs:write")
    && context.input.guard_ok
}
when temporal {
    formerly within 1h Tel::Action::"Prepare"::request{
        input.pending_id: context.input.pending_id
    }
};

// Исполнение только после подтверждения той же карточки.
@id("execute_confirmed_card")
permit (principal, action == Tel::Action::"Execute", resource)
when {
    context.input.role == "client"
    && context.input.scopes.contains("tariffs:write")
    && context.input.guard_ok
}
when temporal {
    formerly within 1h Tel::Action::"ConfirmCard"::request{
        input.pending_id: context.input.pending_id
    }
};

// Не больше двух смен тарифа за сессию: третий запрос Execute запрещён.
// Считаются только tariff_change — услуги и контакты лимит не тратят.
@id("tariff_change_session_limit")
forbid (principal, action == Tel::Action::"Execute", resource)
when { context.input.action == "tariff_change" }
when temporal {
    count_within(24h, Tel::Action::"Execute"::request{ input.action: "tariff_change" }) > 2
};
